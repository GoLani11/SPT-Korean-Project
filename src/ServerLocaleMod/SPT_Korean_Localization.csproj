<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SPT_Korean_Localization</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>2.0.2</Version>
        <AssemblyName>SPT_Korean_Localization</AssemblyName>
        <OutputPath>$(ArtifactsRoot)build\$(Configuration)\ServerLocaleMod41\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <!-- AssemblyInfo is kept in source for the SPT mod metadata. -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

        <!-- Keep package output small. -->
        <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
        <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
        <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
        <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
    </ItemGroup>

</Project>
