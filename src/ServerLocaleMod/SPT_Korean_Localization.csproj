<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SPT_Korean_Localization</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>1.6.0</Version>
        <AssemblyName>SPT_Korean_Localization</AssemblyName>
        <OutputPath>$(ArtifactsRoot)build\$(Configuration)\ServerLocaleMod\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <!-- AssemblyInfo is kept in source for the SPT mod metadata. -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

        <!-- Keep package output small. -->
        <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
        <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
        <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
        <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
    </ItemGroup>

    <!-- Copy locale data beside the server mod DLL. -->
    <ItemGroup>
        <None Include="locale\**\*" Exclude="locale\**\AGENTS.md;locale\**\CLAUDE.md;locale\kr-only.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
