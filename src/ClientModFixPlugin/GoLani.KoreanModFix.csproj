<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>KoreanPatchFix</RootNamespace>
        <AssemblyName>GoLani.KoreanModFix</AssemblyName>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <Version>2.0.1</Version>
        <OutputPath>$(ArtifactsRoot)build\$(Configuration)\ClientModFixPlugin\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <CopyLocalDependenciesWhenParentReferenceInPackage>false</CopyLocalDependenciesWhenParentReferenceInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <ClientReferenceSptRoot Condition="'$(ClientReferenceSptRoot)' == ''">D:\SPT3.8.3</ClientReferenceSptRoot>
        <BepInExCore>$(ClientReferenceSptRoot)\BepInEx\core</BepInExCore>
        <ManagedRefs>$(ClientReferenceSptRoot)\EscapeFromTarkov_Data\Managed</ManagedRefs>
    </PropertyGroup>

    <!--
      Build only against the BepInEx, Harmony, Unity, and TextMeshPro APIs shared by
      every supported client. All EFT/SPT types are discovered at runtime.
    -->
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(ManagedRefs)\Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(ManagedRefs)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedRefs)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ManagedRefs)\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
