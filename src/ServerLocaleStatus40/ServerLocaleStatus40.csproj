<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.2.0</Version>
    <AssemblyName>GoLani.KoreanLocalization.Status</AssemblyName>
    <DefineConstants>$(DefineConstants);SPT_40</DefineConstants>
    <OutputPath>$(ArtifactsRoot)build\$(Configuration)\ServerLocaleStatus40\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ServerLocaleStatus\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\ClientLocalePrototype\ClientLocaleBuild.cs" Link="ClientLocaleBuild.cs" />
    <Compile Include="..\ClientLocalePrototype\ClientLocaleProfilePolicy.cs" Link="ClientLocaleProfilePolicy.cs" />
    <PackageReference Include="SPTarkov.Common" Version="4.0.13" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.13" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" />
  </ItemGroup>
</Project>
