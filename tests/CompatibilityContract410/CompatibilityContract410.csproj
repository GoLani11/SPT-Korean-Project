<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DefineConstants>$(DefineConstants);SPT_410</DefineConstants>
        <OutputPath>$(ArtifactsRoot)build\$(Configuration)\CompatibilityContract410\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\CompatibilityContract\Program.cs" Link="Program.cs" />
        <Compile Include="..\..\src\Shared\SptCompatibilityPolicy.cs" Link="SptCompatibilityPolicy.cs" />
        <PackageReference Include="SemanticVersioning" Version="3.0.0" />
    </ItemGroup>

</Project>
